# .env.prod.example — ШАБЛОН production-секретов FaceID Core.
#
# Скопируйте в .env.prod и подставьте реальные значения:
#   cp .env.prod.example .env.prod
#
# .env.prod НЕ в git (.gitignore). НЕ коммитить — содержит ключ шифрования
# биометрии (152-ФЗ) и JWT/API-секреты.
#
# Запуск стека:
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Флаги hardening (ENV=production, LIVENESS_ENABLED=true, LIVENESS_ACTIVE_REQUIRED=true,
# QUALITY_GATE_MODE=hard, FAISS_ENABLED=true, AUTH_ENABLED=true) выставлены в
# docker-compose.prod.yml — здесь их повторять не нужно. Здесь — только секреты
# и параметры, уникальные для конкретного деплоя.

# ─────────────────────────────────────────────────────────────────────
# PostgreSQL (compose interpolation: ${POSTGRES_PASSWORD} в docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=faceid

# ─────────────────────────────────────────────────────────────────────
# MinIO (compose interpolation: ${MINIO_ROOT_USER}/${MINIO_ROOT_PASSWORD})
# ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=faceid_admin
MINIO_ROOT_PASSWORD=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_ПАРОЛЬ
MINIO_BUCKET=face-images
MINIO_SECURE=false

# ─────────────────────────────────────────────────────────────────────
# Biometry encryption (152-ФЗ: AES-256-GCM для эмбеддингов)
# ─────────────────────────────────────────────────────────────────────
# Сгенерировать: python scripts/gen_aes_key.py
# В production без ключа сервис падает при старте (fail-closed).
BIOMETRY_AES_KEY_B64=ЗАМЕНИТЬ_НА_ВЫВОД_scripts/gen_aes_key.py

# ─────────────────────────────────────────────────────────────────────
# Auth (ТЗ 3.1: защита эндпоинтов)
# ─────────────────────────────────────────────────────────────────────
# Мастер-переключатель (true в prod). Выставлен в docker-compose.prod.yml.
AUTH_ENABLED=true
# Секрет HS256 для JWT. НЕ дефолтный SECRET_KEY — задайте уникальный.
JWT_SECRET=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_JWT_СЕКРЕТ
# Базовый секрет приложения (fallback для JWT если JWT_SECRET не задан —
# в prod задавать оба уникальными).
SECRET_KEY=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_APP_СЕКРЕТ
# Service-to-service API-ключи, CSV: "key1,key2". Хранятся как множество для O(1).
API_KEYS=ЗАМЕНИТЬ_НА_API_KEY_1,ЗАМЕНИТЬ_НА_API_KEY_2

# ─────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis

# ─────────────────────────────────────────────────────────────────────
# ML thresholds (не поднимать без реал-валидации на целевых парах СКУД)
# ─────────────────────────────────────────────────────────────────────
# FACE_MATCH_THRESHOLD=0.45 — operating point под ТЗ (FAR≤0.1%, FRR≈2.7% на LFW).
# ВНИМАНИЕ: 0.73 даёт FRR=69% (calibrate_face_threshold.py). Не поднимать.
FACE_MATCH_THRESHOLD=0.45
FACE_LOW_THRESHOLD=0.30
FACE_MARGIN_THRESHOLD=0.10
# Liveness порог подтверждён серией (clean live 0.895–0.999). Не трогать.
LIVENESS_THRESHOLD=0.859